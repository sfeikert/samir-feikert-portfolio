---
import '../styles/global.css';

const {
  title = 'Samir Feikert — Fotograf aus Düsseldorf',
  description = 'Ausgebildeter Fotograf aus Düsseldorf mit Fokus auf authentische Bilder – analog inspiriert, aber modern und auf das Wesentliche reduziert.',
  ogImage = null,
  preloadImage = null,
  noindex = false,
  jsonLd = null,
} = Astro.props;

const siteOrigin = Astro.site || 'https://samirfeikert.com';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteOrigin).href : null;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph / Social Sharing Previews (WhatsApp, iMessage, Instagram, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Samir Feikert" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        imagesrcset={preloadImage.srcSet}
        imagesizes={preloadImage.srcSet ? preloadImage.sizes : undefined}
        fetchpriority="high"
      />
    )}
  </head>

  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-ink focus:text-white focus:px-4 focus:py-2 focus:font-sans focus:text-xs focus:uppercase focus:tracking-wider"
    >
      Zum Inhalt springen
    </a>
    <slot />
  </body>
</html>
