---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGalleryView from '../../components/ProjectGalleryView.jsx';
import { siteIdentity, getAllProjects, exhibitionItems as defaultExhibitionItems } from '../../data/projects.js';
import { loadMedienProjects } from '../../utils/loadMedien.js';

export function getStaticPaths() {
  const medienData = loadMedienProjects();
  const projects = medienData?.projects?.length ? medienData.projects : getAllProjects();

  return projects.map((project, idx) => {
    const nextProject =
      projects.length > 1
        ? {
            slug: projects[(idx + 1) % projects.length].slug,
            label: projects[(idx + 1) % projects.length].label,
          }
        : null;

    return {
      params: { slug: project.slug },
      props: { project, nextProject },
    };
  });
}

const { slug } = Astro.params;
const medienData = loadMedienProjects();
const projects = medienData?.projects?.length ? medienData.projects : getAllProjects();
const currentIdx = projects.findIndex((p) => p.slug === slug);
const project = (currentIdx !== -1 ? projects[currentIdx] : null) || Astro.props.project;
const nextProject =
  projects.length > 1 && currentIdx !== -1
    ? {
        slug: projects[(currentIdx + 1) % projects.length].slug,
        label: projects[(currentIdx + 1) % projects.length].label,
      }
    : Astro.props.nextProject || null;

const activeExhibitionItems = medienData?.exhibitionItems?.length
  ? medienData.exhibitionItems
  : defaultExhibitionItems;
const pageTitle = project?.label
  ? `${project.label} — ${siteIdentity.name}`
  : `${siteIdentity.name} — Fotograf aus Düsseldorf`;
const pageDescription = `${project?.label || 'Projekt'} — Fotografische Serie von Samir Feikert, Fotograf aus Düsseldorf.`;

const firstMedia = project?.images?.[0];
let preloadImage = null;
if (firstMedia?.type !== 'video' && (firstMedia?.stageSrc || firstMedia?.src)) {
  preloadImage = {
    href: firstMedia.stageSrc || firstMedia.src,
    srcSet: firstMedia.stageSrcSet,
    sizes: '(min-width: 640px) 80vw, 88vw',
  };
} else if (firstMedia?.type === 'video' && (firstMedia.posterWebp || firstMedia.poster)) {
  preloadImage = {
    href: firstMedia.posterWebp || firstMedia.poster,
  };
}

const ogImage =
  (firstMedia?.type === 'video'
    ? firstMedia.posterWebp || firstMedia.poster || project?.poster
    : firstMedia?.stageSrc ||
      firstMedia?.thumbSrc ||
      firstMedia?.src ||
      project?.thumbSrc ||
      project?.src) || '/apple-touch-icon.png';

const publicIdentity = {
  name: siteIdentity.name,
  subtitle: siteIdentity.subtitle,
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  preloadImage={preloadImage}
>
  <ProjectGalleryView
    client:load
    identity={publicIdentity}
    project={project}
    exhibitionItems={activeExhibitionItems}
    nextProject={nextProject}
  />
</BaseLayout>
