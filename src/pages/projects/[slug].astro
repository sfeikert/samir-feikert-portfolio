---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGalleryView from '../../components/ProjectGalleryView.jsx';
import { siteIdentity, getAllProjects, exhibitionItems as defaultExhibitionItems } from '../../data/projects.js';
import { loadMedienProjects } from '../../utils/loadMedien.js';

export function getStaticPaths() {
  const medienData = loadMedienProjects();
  const projects = medienData?.projects?.length ? medienData.projects : getAllProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { slug } = Astro.params;
const medienData = loadMedienProjects();
const project =
  medienData?.projects?.find((p) => p.slug === slug) || Astro.props.project;
const activeExhibitionItems = medienData?.exhibitionItems?.length
  ? medienData.exhibitionItems
  : defaultExhibitionItems;
const pageTitle = project?.label
  ? `${project.label} — ${siteIdentity.name}`
  : `${siteIdentity.name} — Photographer`;
const publicIdentity = {
  name: siteIdentity.name,
  subtitle: siteIdentity.subtitle,
};
---

<BaseLayout title={pageTitle}>
  <ProjectGalleryView
    client:load
    identity={publicIdentity}
    project={project}
    exhibitionItems={activeExhibitionItems}
  />
</BaseLayout>
