---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBar from '../components/HeaderBar.jsx';
import DriftingGallery from '../components/DriftingGallery.jsx';
import MinimalFooter from '../components/MinimalFooter.jsx';
import { siteIdentity, galleryRows, exhibitionItems as defaultExhibitionItems } from '../data/projects.js';
import { loadMedienProjects } from '../utils/loadMedien.js';

const medienData = loadMedienProjects();
const activeRows = medienData?.rows?.length ? medienData.rows : galleryRows;
const activeExhibitionItems = medienData?.exhibitionItems?.length
  ? medienData.exhibitionItems
  : defaultExhibitionItems;

// Strip per-project `images[]` arrays from homepage island props (keeps index.html slim)
const homeRows = activeRows.map((row) => ({
  id: row.id,
  slides: row.slides.map((slide) => ({
    slug: slide.slug,
    type: slide.type,
    src: slide.src,
    thumbSrc: slide.thumbSrc,
    thumbSrcSet: slide.thumbSrcSet,
    poster: slide.poster,
    posterWebp: slide.posterWebp,
    width: slide.width,
    height: slide.height,
    intrinsicAspect: slide.intrinsicAspect,
    label: slide.label,
    wide: slide.wide,
    aspect: slide.aspect,
    startIndex: slide.startIndex,
    layoutWidths: slide.layoutWidths,
  })),
}));

const firstImageSlide = homeRows[0]?.slides?.find((slide) => slide.type !== 'video');
const firstWidths = firstImageSlide?.layoutWidths;
const lcpPreload = firstImageSlide
  ? {
      href: firstImageSlide.thumbSrc || firstImageSlide.src,
      srcSet: firstImageSlide.thumbSrcSet,
      sizes: firstWidths
        ? `(min-width: 1024px) ${firstWidths.lg}vw, (min-width: 640px) ${firstWidths.md}vw, ${firstWidths.sm}vw`
        : firstImageSlide.wide
          ? '(min-width: 1024px) 50vw, (min-width: 640px) 55vw, 94vw'
          : '(min-width: 1024px) 25vw, (min-width: 640px) 55vw, 80vw',
    }
  : null;
const homeOgImage = firstImageSlide?.thumbSrc || firstImageSlide?.src || '/apple-touch-icon.png';
const publicIdentity = {
  name: siteIdentity.name,
  subtitle: siteIdentity.subtitle,
  heroIntro: siteIdentity.heroIntro,
};
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Samir Feikert',
  jobTitle: 'Fotograf',
  description: siteIdentity.heroIntro,
  url: 'https://samirfeikert.com/',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Düsseldorf',
    addressCountry: 'DE',
  },
  sameAs: [siteIdentity.instagram?.url || 'https://www.instagram.com/samirfeikert/'],
};
---

<BaseLayout
  title="Samir Feikert — Fotograf aus Düsseldorf"
  description={siteIdentity.heroIntro}
  ogImage={homeOgImage}
  preloadImage={lcpPreload}
  jsonLd={homeJsonLd}
>
  <HeaderBar client:load identity={publicIdentity} exhibitionItems={activeExhibitionItems} />
  <main id="main-content">
    <DriftingGallery client:load rows={homeRows} />
  </main>
  <MinimalFooter />
</BaseLayout>
