---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBar from '../components/HeaderBar.jsx';
import DriftingGallery from '../components/DriftingGallery.jsx';
import MinimalFooter from '../components/MinimalFooter.jsx';
import { siteIdentity, galleryRows } from '../data/projects.js';
import { loadMedienProjects } from '../utils/loadMedien.js';

const medienData = loadMedienProjects();
const activeRows = medienData?.rows?.length ? medienData.rows : galleryRows;
---

<BaseLayout title="Samir Feikert — Photographer">
  <div class="sf-snap-container">
    <HeaderBar client:load identity={siteIdentity} />
    <main id="main-content">
      <DriftingGallery client:load identity={siteIdentity} rows={activeRows} />
    </main>
    <MinimalFooter client:visible identity={siteIdentity} />
  </div>
</BaseLayout>
