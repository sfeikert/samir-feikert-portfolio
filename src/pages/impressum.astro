---
import BaseLayout from '../layouts/BaseLayout.astro';
import SfMonogram from '../components/SfMonogram.jsx';
import { siteIdentity } from '../data/projects.js';

const street = siteIdentity.address?.street || 'Ruhrtalstraße 16';
const city = siteIdentity.address?.city || '40233 Düsseldorf';
const country = siteIdentity.address?.country || 'Deutschland';
const phone = siteIdentity.phone || '+49 176 31501119';
---

<BaseLayout
  title="Impressum — Samir Feikert"
  description="Impressum gemäß § 5 DDG — Samir Feikert, Fotograf aus Düsseldorf."
  noindex={true}
>
  <div class="min-h-screen w-full bg-white text-ink flex flex-col justify-between">
    <header class="w-full max-w-3xl mx-auto px-6 sm:px-10 pt-[max(1.25rem,env(safe-area-inset-top))] pb-4 flex items-center justify-between gap-4 border-b border-ink/10">
      <a href="/" class="sf-pill">
        ← Übersicht
      </a>
      <a
        href="/"
        aria-label="Zur Startseite"
        class="sf-pill"
      >
        <SfMonogram />
      </a>
    </header>

    <main id="main-content" class="flex-1 w-full max-w-3xl mx-auto px-6 sm:px-10 py-14 sm:py-20">
      <article class="space-y-8 font-sans text-sm leading-relaxed text-ink-muted">
        <header class="border-b border-ink/10 pb-5">
          <h1 class="font-display font-medium uppercase text-xl sm:text-2xl tracking-[-0.01em] text-ink">
            Impressum (§ 5 DDG)
          </h1>
        </header>

        <section class="space-y-1">
          <h2 class="font-medium text-ink uppercase tracking-wider text-[11px] mb-2">
            Angaben gemäß § 5 DDG
          </h2>
          <p class="font-medium text-ink">{siteIdentity.name}</p>
          <p>Fotograf</p>
          <p>{street}</p>
          <p>{city}</p>
          <p>{country}</p>
        </section>

        <section class="space-y-1">
          <h2 class="font-medium text-ink uppercase tracking-wider text-[11px] mb-2">
            Kontakt
          </h2>
          <p>
            Telefon:{' '}
            <a href={`tel:${phone}`} class="text-ink hover:opacity-70 underline underline-offset-4">
              {phone}
            </a>
          </p>
          <p>
            E-Mail:{' '}
            <a
              href={`mailto:${siteIdentity.email}`}
              class="text-ink hover:opacity-70 underline underline-offset-4"
            >
              {siteIdentity.email}
            </a>
          </p>
        </section>

        <section class="space-y-1">
          <h2 class="font-medium text-ink uppercase tracking-wider text-[11px] mb-2">
            Umsatzsteuer
          </h2>
          <p>
            Gemäß § 19 UStG wird keine Umsatzsteuer berechnet (Kleinunternehmerregelung).
          </p>
        </section>

        <section class="space-y-1">
          <h2 class="font-medium text-ink uppercase tracking-wider text-[11px] mb-2">
            Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV
          </h2>
          <p>
            {siteIdentity.name}, {street}, {city}
          </p>
        </section>

        <section class="space-y-1">
          <h2 class="font-medium text-ink uppercase tracking-wider text-[11px] mb-2">
            Urheberrecht
          </h2>
          <p>
            Die auf dieser Website veröffentlichten Fotografien, Videos und Texte unterliegen dem
            deutschen Urheberrecht. Jede Art der Vervielfältigung, Bearbeitung, Verbreitung oder
            sonstigen Verwertung bedarf meiner vorherigen schriftlichen Zustimmung.
          </p>
        </section>

        <section class="space-y-1">
          <h2 class="font-medium text-ink uppercase tracking-wider text-[11px] mb-2">
            Verbraucherstreitbeilegung (§ 36 VSBG)
          </h2>
          <p>
            Ich bin nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
            Verbraucherschlichtungsstelle teilzunehmen.
          </p>
        </section>
      </article>
    </main>

    <footer class="w-full max-w-3xl mx-auto px-6 sm:px-10 py-5 border-t border-ink/10 flex items-center justify-between gap-6 font-sans text-xs tracking-[0.12px] text-ink-muted">
      <a href="/" class="inline-flex items-center min-h-[44px] hover:text-ink transition-colors">
        ← Übersicht
      </a>
      <a href="/datenschutz" class="inline-flex items-center min-h-[44px] hover:text-ink transition-colors">
        Datenschutz
      </a>
    </footer>
  </div>
</BaseLayout>
