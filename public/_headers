/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=2592000

/medien/_thumbs/*
  Cache-Control: public, max-age=31536000, immutable

/medien/startseite/*
  Cache-Control: public, max-age=2592000

/medien/Exhibition/*
  Cache-Control: public, max-age=2592000

/impressum
  X-Robots-Tag: noindex, nofollow

/impressum/*
  X-Robots-Tag: noindex, nofollow

/datenschutz
  X-Robots-Tag: noindex, nofollow

/datenschutz/*
  X-Robots-Tag: noindex, nofollow

/404
  X-Robots-Tag: noindex, nofollow

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'none'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
